import { HorizontalBox, VerticalBox, Palette } from "std-widgets.slint";

export struct LauncherEntry {
    icon: image,
    name: string,
    generic_name: string,
    description: string,
    id: int,
}

export global LauncherEntries {
    in-out property <[LauncherEntry]> entries;
}

export component LauncherEntryDelegate inherits Rectangle {
    in property <LauncherEntry> entry;
    in property <bool> selected;

    background: self.selected ? white.transparentize(90%) : transparent;
    border-radius: 16px;

    HorizontalBox {
        alignment: start;

        Image {
            height: 32px;
            width: self.height;
            horizontal-alignment: ImageHorizontalAlignment.left;
            horizontal-tiling: ImageTiling.none;
            image-fit: ImageFit.contain;
            source: entry.icon;
        }

        VerticalLayout {
            alignment: center;
            // Slint's center text alignment appears to align on the baseline,
            // so we push it down ever so slightly.
            padding-top: entry.description == "" ? 2px : 0px;
            
            HorizontalLayout {
                alignment: start;

                Text {
                    text: entry.name;
                    vertical-alignment: center;
                    overflow: clip;
                }

                if entry.generic-name != "": Text {
                    text: " (\{entry.generic-name})";
                    vertical-alignment: center;
                    font-italic: true;
                    font-size: 0.7rem;
                    overflow: clip;
                }
            }

            if entry.description != "": Text {
                text: entry.description;
                font-size: 0.7rem;
                color: Palette.foreground.darker(1);
                overflow: elide;
            }
        }
    }
}

/// A minimal stand-in for the std `ListView`, with a plain scroll indicator.
///
/// The std `ListView` is a (fluent) `ScrollView`, whose scrollbar buttons are SVG icons. Decoding
/// any SVG makes Slint load the whole system font database on the UI thread, which takes about
/// half of the launcher window's creation time.
///
/// This component must be named `ListView`: that is how the Slint compiler recognises a list
/// view, and only instantiates the visible items of a `for` placed directly in it.
component ListView {
    out property <length> visible-width <=> flickable.width;
    out property <length> visible-height <=> flickable.height;
    in-out property <length> viewport-width <=> flickable.viewport-width;
    in-out property <length> viewport-height <=> flickable.viewport-height;
    in-out property <length> viewport-x <=> flickable.viewport-x;
    in-out property <length> viewport-y <=> flickable.viewport-y;
    in-out property <bool> has-focus;

    /// A left click (without dragging) at `position`, relative to this list view.
    callback clicked(position: Point);
    /// A right mouse button press at `position`, relative to this list view.
    callback right-pressed(position: Point);

    /// Stop any ongoing flick.
    public function stop-flick() {
        momentum.running = false;
    }

    min-height: 50px;
    min-width: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-height: 100%;
    preferred-width: 100%;
    accessible-role: list;

    // Dragging the content is implemented by `drag-area` below rather than by the Flickable: its built-in
    // flicking uses the average speed of the whole drag and stops after a fixed 250ms, which
    // feels abrupt. The Flickable still handles mouse wheel and touchpad scrolling.
    flickable := Flickable {
        interactive: false;
        width: parent.width;
        height: parent.height;

        @children
    }

    /// Distance the pointer must move before a press becomes a drag
    property <length> drag-threshold: 8px;
    /// Velocity (in px per ms) is smoothed over this fraction of the latest measurement
    property <float> velocity-smoothing: 0.6;
    /// Releasing after holding still for this long doesn't flick
    property <duration> flick-timeout: 80ms;
    /// The flick velocity is multiplied by this every millisecond
    property <float> friction: 0.997;
    /// Below this velocity (in px per ms), a flick stops
    property <float> min-velocity: 0.02;

    property <bool> dragging;
    property <length> drag-start-viewport-y;
    property <length> last-y;
    property <duration> last-time;
    property <float> velocity; // px per ms, positive is towards the end of the list

    pure function clamp-viewport-y(y: length) -> length {
        return max(min(0px, flickable.height - flickable.viewport-height), min(0px, y));
    }

    drag-area := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.stop-flick();
                root.dragging = false;
                root.drag-start-viewport-y = flickable.viewport-y;
                root.last-y = self.mouse-y;
                root.last-time = animation-tick();
                root.velocity = 0;
            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                if (root.dragging) {
                    // only flick if the pointer was still moving when released
                    if (animation-tick() - root.last-time < root.flick-timeout && abs(root.velocity) > root.min-velocity) {
                        momentum.last-tick = animation-tick();
                        momentum.running = true;
                    }
                } else {
                    root.clicked({ x: self.mouse-x, y: self.mouse-y });
                }
                root.dragging = false;
            } else if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.stop-flick();
                root.right-pressed({ x: self.mouse-x, y: self.mouse-y });
            }
        }

        moved => {
            if (!self.pressed) {
                return;
            }
            if (!root.dragging && abs(self.mouse-y - self.pressed-y) > root.drag-threshold) {
                root.dragging = true;
            }
            if (root.dragging) {
                flickable.viewport-y = root.clamp-viewport-y(root.drag-start-viewport-y + self.mouse-y - self.pressed-y);

                let now = animation-tick();
                let elapsed = (now - root.last-time) / 1ms;
                if (elapsed > 0) {
                    let instant-velocity = (root.last-y - self.mouse-y) / 1px / elapsed;
                    root.velocity = root.velocity-smoothing * instant-velocity + (1 - root.velocity-smoothing) * root.velocity;
                    root.last-y = self.mouse-y;
                    root.last-time = now;
                }
            }
        }

        scroll-event(event) => {
            // let the Flickable handle scrolling, but stop flicking first
            root.stop-flick();
            reject
        }
    }

    /// How far the content can scroll
    property <length> scroll-range: flickable.viewport-height - flickable.height;
    property <length> thumb-height: max(16px, root.height * root.height / flickable.viewport-height);
    property <length> thumb-y: (root.height - root.thumb-height) * (-flickable.viewport-y / root.scroll-range);

    /// Scroll such that the top of the scrollbar's thumb is at `y`.
    function scroll-thumb-to(y: length) {
        flickable.viewport-y = root.clamp-viewport-y(-y / (root.height - root.thumb-height) * root.scroll-range);
    }

    // On top of `drag-area`, so that it gets pointer events first.
    if root.scroll-range > 0: scrollbar := TouchArea {
        x: root.width - self.width;
        width: 12px;
        height: root.height;

        /// Where on the thumb it was grabbed
        property <length> grab-offset;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.stop-flick();
                if (self.mouse-y >= root.thumb-y && self.mouse-y <= root.thumb-y + root.thumb-height) {
                    self.grab-offset = self.mouse-y - root.thumb-y;
                } else {
                    // pressed beside the thumb: jump there, centering the thumb on the pointer
                    self.grab-offset = root.thumb-height / 2;
                    root.scroll-thumb-to(self.mouse-y - self.grab-offset);
                }
            }
        }

        moved => {
            if (self.pressed) {
                root.scroll-thumb-to(self.mouse-y - self.grab-offset);
            }
        }

        thumb := Rectangle {
            x: parent.width - self.width - 2px;
            y: root.thumb-y;
            width: parent.has-hover || parent.pressed ? 6px : 3px;
            height: root.thumb-height;
            border-radius: self.width / 2;
            background: Palette.foreground.transparentize(parent.pressed ? 40% : 70%);

            animate width { duration: 100ms; }
        }
    }

    momentum := Timer {
        interval: 16ms;
        running: false;

        property <duration> last-tick;

        triggered => {
            let now = animation-tick();
            let elapsed = (now - self.last-tick) / 1ms;
            self.last-tick = now;

            let new-y = root.clamp-viewport-y(flickable.viewport-y - root.velocity * elapsed * 1px);
            if (new-y == flickable.viewport-y) {
                // reached either end of the list
                self.running = false;
                return;
            }
            flickable.viewport-y = new-y;

            root.velocity *= Math.pow(root.friction, elapsed);
            if (abs(root.velocity) < root.min-velocity) {
                self.running = false;
            }
        }
    }
}

component StandardListViewBase inherits ListView {
    in property <[LauncherEntry]> model;
    in-out property <int> current-item: -1;

    callback current-item-changed(current-item: int);
    /// Emitted when the context menu of an item is requested by right-clicking it.
    /// `position` is relative to the window.
    callback context-menu-requested(item: int, position: Point);

    public function set-current-item-next() {
        set-current-item(Math.mod(current-item + 1, model.length))
    }

    public function set-current-item-previous() {
        set-current-item(Math.mod(current-item - 1, model.length))
    }

    public function set-current-item(index: int) {
        if (index < 0 || index >= model.length || index == root.current-item) {
            return;
        }
        bring-into-view(index);

        current-item = index;
        focus-item = index;
        current-item-changed(current-item);
    }

    /// The y position (relative to this list view) of the bottom of the current item.
    public pure function current-item-bottom() -> length {
        return root.item-y(root.current-item) + root.item-height;
    }

    /// Scroll the content up by `amount` (as far as the content allows), revealing items below.
    public function scroll-content-up(amount: length) {
        root.viewport-y = max(min(0px, root.visible-height - root.viewport-height), root.viewport-y - amount);
    }

    private property <length> item-height: self.viewport-height / self.model.length;
    private property <int> into-view-item: 0;
    private property <length> into-view-item-y: root.item-y(root.into-view-item);
    private property <length> current-item-y: root.item-y(root.focus-item);
    private property <int> focus-item: 0;
    private property <bool> has-item-been-selected: false;

    accessible-delegate-focus: root.focus-item;
    accessible-item-count: root.model.length;

    pure function first-visible-item() -> int {
        return min(root.model.length - 1, max(0, round(-root.viewport-y / root.item-height)));
    }

    pure function last-visible-item() -> int {
        return min(root.model.length - 1, max(0, round((-root.viewport-y + root.height - root.item-height) / root.item-height)));
    }

    pure function item-y(index: int) -> length {
        return root.viewport-y + index * root.item-height;
    }

    /// The index of the item at `y` (relative to this list view).
    pure function item-at-y(y: length) -> int {
        return min(root.model.length - 1, max(0, floor((y - root.viewport-y) / root.item-height)));
    }

    function bring-into-view(index: int) {
        if (index < 0 || index >= model.length) {
            return;
        }
        root.stop-flick();
        into-view-item = index;

        if (into-view-item-y < 0) {
            self.viewport-y -= into-view-item-y;
        }
        if (into-view-item-y + item-height > self.visible-height) {
            self.viewport-y -= into-view-item-y + item-height - self.visible-height;
        }
    }

    protected function focus-up() {
        root.set-focus-item(root.focus-item - 1);
    }

    protected function focus-page-up() {
        root.set-focus-item(root.current-item - (root.height / root.item-height) + 2)
    }

    protected function focus-first() {
        root.set-focus-item(0);
    }

    protected function focus-down() {
        root.set-focus-item(root.focus-item + 1);
    }

    protected function focus-page-down() {
        root.set-focus-item(root.current-item + (root.height / root.item-height) - 1)
    }

    protected function focus-last() {
        root.set-focus-item(root.model.length - 1);
    }

    protected function select-focus-item() {
        root.set-current-item(root.focus-item);
    }

    protected function focus-current-item() {
        if (root.current-item == -1 && !root.has-item-been-selected && root.model.length > 0) {
            root.set-current-item(0);
        }
        root.has-item-been-selected = true;

        if (root.current-item-y + root.item-height < 0 || root.current-item-y > root.height) {
            root.focus-item = root.first-visible-item();
        }
    }

    protected function toggle-focus-item-selection() {
        if (root.current-item == root.focus-item) {
            root.current-item = -1;
        } else {
            root.select-focus-item();
        }
    }

    protected function set-focus-item(index: int) {
        root.focus-item = min(root.model.length - 1, max(0, index));
        root.bring-into-view(root.focus-item);
    }

    // Pointer input is handled for the whole list by `ListView`, as items can't tell a click from
    // the start of a drag.
    clicked(position) => {
        root.set-current-item(root.item-at-y(position.y));
    }

    right-pressed(position) => {
        let index = root.item-at-y(position.y);
        root.set-current-item(index);
        root.context-menu-requested(index, {
            x: root.absolute-position.x + position.x,
            y: root.absolute-position.y + position.y,
        });
    }

    for item[index] in root.model: LauncherEntryDelegate {
        selected: index == root.current-item;
        entry: item;
    }
}

export component LauncherListView inherits StandardListViewBase {
    forward-focus: i-focus-scope;

    public function key-pressed(event: KeyEvent) -> EventResult {
        return i-focus-scope.key-pressed(event);
    }

    i-focus-scope := FocusScope {
        x: 0;
        width: 0;  // Do not react on clicks

        focus-changed-event => {
            root.focus-current-item();
            root.has-focus = self.has-focus;
        }

        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.focus-up();
                if (!event.modifiers.control) {
                    root.select-focus-item();
                }
                return accept;
            } else if (event.text == Key.PageUp) {
                root.focus-page-up();
                if (!event.modifiers.control) {
                    root.select-focus-item();
                }
                return accept;
            } else if (event.text == Key.Home) {
                root.focus-first();
                if (!event.modifiers.control) {
                    root.select-focus-item();
                }
                return accept;
            } else if (event.text == Key.DownArrow) {
                root.focus-down();
                if (!event.modifiers.control) {
                    root.select-focus-item();
                }
                return accept;
            } else if (event.text == Key.PageDown) {
                root.focus-page-down();
                if (!event.modifiers.control) {
                    root.select-focus-item();
                }
                return accept;
            } else if (event.text == Key.End) {
                root.focus-last();
                if (!event.modifiers.control) {
                    root.select-focus-item();
                }
                return accept;
            }
            reject
        }
    }
}
